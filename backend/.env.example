# Copy this file to ".env" for local work. NEVER commit the real ".env".
# (The app reads real environment variables; use `export $(cat .env | xargs)` or your shell/IDE to load them.)

# --- Security ---
# Secret used to sign JWT tokens. Use at least 32 random characters.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# How long a login token stays valid, in minutes.
JWT_EXPIRE_MINUTES=60

# The exact URL of the deployed frontend (no trailing slash). Only this origin may call the API.
# Several origins can be given separated by commas.
FRONTEND_ORIGIN=http://localhost:5173

# --- Evaluation account (created/updated automatically on startup) ---
EVAL_USERNAME=panel
EVAL_PASSWORD=choose-a-strong-password-here

# --- Database ---
# SQLite file path. The file is only reachable by the backend process (no network port).
DATABASE_PATH=./data/dashboard.db

# --- Collector ---
# Set to "false" to switch off background collection (used by the tests).
ENABLE_COLLECTOR=true
# Seconds between ticker refreshes while the market is open (minimum 30).
TICKER_REFRESH_SECONDS=60
# Hours between refreshes of the slow-moving macro indicators.
MACRO_REFRESH_HOURS=12
# Seconds before an upstream request is abandoned.
UPSTREAM_TIMEOUT_SECONDS=10
